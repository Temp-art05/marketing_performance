{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/kb/hooks/run.mjs\" session-start", "timeout": 150 }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/kb/hooks/run.mjs\" post-tool-use", "timeout": 30 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/kb/hooks/run.mjs\" stop", "timeout": 30 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/kb/hooks/run.mjs\" session-end", "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/kb/hooks/run.mjs\" session-end" }] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/kb/cli.mjs:*)",
      "Bash(npm run kb:*)",
      "Bash(npm test:*)",
      "Edit(knowledge/**)",
      "Write(knowledge/**)"
    ]
  }
}
